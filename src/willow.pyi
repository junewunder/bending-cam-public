from typing import Any, Callable, Generic, TypeVar, overload

T = TypeVar("T")
C = TypeVar("C", bound="Component")
F = TypeVar("F", bound=Callable[..., Any])

class Setter(Generic[T]):
    @overload
    def __call__(self, v: Callable[[T], T]) -> None: ...
    @overload
    def __call__(self, v: T) -> None: ...

@overload
def state(default: Callable[[], T]) -> tuple[T, Setter[T]]: ...
@overload
def state(default: T) -> tuple[T, Setter[T]]: ...
def ref(fn: Callable[[], T]) -> T: ...
def prop() -> Any: ...
def comp(cls: type[C], **props: Callable[[Any], Any]) -> C: ...
def on(*names: str) -> Callable[[F], F]: ...

class Component:
    rendered: Any
    app: Any
    def mount(self) -> None: ...
    def render(self) -> Any: ...
    def bind(self, label: str, fn: Callable[[Any], Any]) -> None: ...
    def once(self, label: str, fn: Callable[[Any], Any]) -> None: ...
    def cancel(self, label: str) -> None: ...
    def remove(self, label: str) -> None: ...
    def after(self, secs: float, label: str, payload: Any = None) -> None: ...
    def emit(self, label: str, payload: Any = None) -> None: ...
    def set_timeout(self, label: str, secs: float, fn: Callable[[Any], Any]) -> None: ...
    def clear_timeout(self, label: str) -> None: ...

def create(cls: type[C], clock: Callable[[], int] | None = None) -> C: ...
def start(cls: type[C], clock: Callable[[], int] | None = None) -> C: ...
def emit(app: Component, label: str, payload: Any = None) -> bool: ...
def tick(app: Component) -> None: ...
