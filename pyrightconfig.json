{
  "venvPath": ".",
  "venv": ".venv",
  "stubPath": "typings",
  "include": ["src", "tools", "pcb/tools"],
  "exclude": [
    "**/__pycache__",
    "**/node_modules",
    ".venv",
    "vendor",
    "backup"
  ],
  "typeCheckingMode": "standard",

  "reportMissingModuleSource": "none",

  "reportOptionalMemberAccess": "none",
  "reportOptionalSubscript": "none",
  "reportGeneralTypeIssues": "none"
}
